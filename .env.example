# ---------------------------------------------------------------------------
# WAFA website — environment configuration
# Copy to .env and fill in. NEVER upload .env into public_html.
# ---------------------------------------------------------------------------
APP_NAME="WAFA"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://www.example.com

# Absolute path of the web root on the server (Hostinger: hPanel → File Manager shows it),
# e.g. /home/u123456789/domains/example.com/public_html
APP_PUBLIC_PATH=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

# One-time web installer (/install?token=...). Use a random string of 32+ characters,
# run the installer once, then REMOVE this line.
INSTALL_TOKEN=

# Set to true on staging copies so search engines never index them.
SEO_FORCE_NOINDEX=false

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

# Hostinger MySQL (hPanel → Databases → MySQL Databases)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_COOKIE=wafa_session
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# SMTP — Hostinger email (hPanel → Emails). Used for enquiry notifications and password resets.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
